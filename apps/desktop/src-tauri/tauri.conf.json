{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hyphn",
  "version": "0.2.0",
  "identifier": "io.github.1oma1e.hyphn.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hyphn",
        "width": 1320,
        "height": 900,
        "minWidth": 480,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#05070A",
        "theme": "Dark",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["native/*"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDN0NDOTlFNTc2RDUyNTAKUldSUVVtMVhuc2w4N01Zb0RsaTcvR01jUy9Sc0x5MXdoL2s2Z2FhNTJIV3Y0TFNnc1Q1K2VKWHMK",
      "endpoints": ["https://github.com/1oma1e/Hyphn/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
