// The fonts of the app (ui/fonts), for the waiting screen.
#include "resource.h"

IDR_GEIST RCDATA "../../desktop/ui/fonts/Geist-Variable.woff2"
IDR_GEIST_MONO RCDATA "../../desktop/ui/fonts/GeistMono-Variable.woff2"

1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", "Hyphn"
      VALUE "FileDescription", "Hyphn webcam"
      VALUE "ProductName", "Hyphn"
      VALUE "FileVersion", "0.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
